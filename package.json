{
  "name": "attender",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names vite,api --prefix-colors cyan,yellow \"vite\" \"node server/index.js\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
